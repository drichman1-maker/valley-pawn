# Copy to .env.local and fill in. Never put the service-role key in any VITE_ variable:
# everything prefixed VITE_ is shipped to browsers.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Leave unset in production. When Supabase variables are absent and this is "true",
# the site runs in clearly labeled DEMO MODE with in-memory sample data.
# VITE_DEMO_MODE=true
